PORT=4173
HOST=127.0.0.1
STRIDE_DATA_DIR=./data
STRIDE_ADMIN_TOKEN=
STRIDE_WIKIMEDIA_AUTO_DISCOVERY=true

# Amazon India Creators API. Requires Associates enrollment, approved API access,
# a valid partner tag, and compliance with the Associates Program agreement.
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_CREATORS_PARTNER_TAG=
AMAZON_CREATORS_MARKETPLACE=www.amazon.in

# Authorized JSON feed contract; configure only with partner/feed access and
# explicit product-image reuse rights. Each image host must be allowlisted.
STRIDE_FLIPKART_FEED_URL=
STRIDE_FLIPKART_FEED_TOKEN=
STRIDE_FLIPKART_IMAGE_HOSTS=
STRIDE_BRAND_FEED_URL=
STRIDE_BRAND_FEED_TOKEN=
STRIDE_BRAND_IMAGE_HOSTS=

# QA execution reports + email
# In GitHub Actions these map from Secrets/Variables — never commit real values.
TEST_EMAIL_RECIPIENT=rmanoj@chimeratechnologies.com
QA_EMAIL_PROVIDER=smtp
QA_REPORT_RECIPIENTS=
QA_REPORT_CC=
QA_REPORT_SENDER=
QA_REPORT_SUBJECT_PREFIX=[QA Execution Report]
QA_REPORT_FORMATS=pdf,xlsx
# Keep false until Phase 1 validation email receipt is confirmed
QA_REPORT_AUTO_SEND=false
QA_REPORT_INCLUDE_SCREENSHOTS=true
QA_REPORT_INCLUDE_BUGS=true

# SMTP (prefer GitHub Secrets: SMTP_HOST, SMTP_PORT, SMTP_USERNAME, SMTP_PASSWORD, SMTP_FROM_EMAIL)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# Optional override; when empty: 465 => TLS/SSL, 587 => STARTTLS
SMTP_SECURE=

# Outlook / Microsoft Graph (optional alternative provider)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
MSAL_TOKEN_CACHE_PATH=./.msal-cache/outlook-token.json

# Zephyr Scale Cloud (read-only reporting). Never commit real tokens.
# Prefer ZEPHYR_SCALE_API_TOKEN; ZEPHYR_API_TOKEN is accepted as an alias.
# This project uses the EU regional endpoint:
ZEPHYR_SCALE_API_BASE_URL=https://eu.api.zephyrscale.smartbear.com/v2
# Other official regions if needed later:
#   https://api.zephyrscale.smartbear.com/v2
#   https://au.api.zephyrscale.smartbear.com/v2
#   https://de.api.zephyrscale.smartbear.com/v2
ZEPHYR_SCALE_API_TOKEN=
ZEPHYR_API_TOKEN=
ZEPHYR_PROJECT_KEY=SCRUM
ZEPHYR_TEST_CYCLE_KEY=
ZEPHYR_TIMEOUT_MS=15000
ZEPHYR_RETRIES=2
# sample | zephyr — live mode never falls back to sample
REPORT_DATA_SOURCE=sample
