{
  "name": "stride-website",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "test:qa-report": "node --test test/qa-report.test.js test/zephyr-report.test.js test/github-actions-context.test.js test/evidence-register.test.js test/report-excel-structure.test.js test/email-send-guard.test.js test/email-auto-send.test.js",
    "test:zephyr-report": "node --test test/zephyr-report.test.js",
    "test:unit": "node --test test/qa-report.test.js test/zephyr-report.test.js test/github-actions-context.test.js test/evidence-register.test.js test/report-excel-structure.test.js test/email-send-guard.test.js test/email-auto-send.test.js",
    "qa:report:generate": "node --env-file-if-exists=.env scripts/qa-report-send.js --generate-only --source sample --story SCRUM-5",
    "qa:report:generate:zephyr": "node --env-file-if-exists=.env scripts/qa-report-send.js --generate-only --source zephyr",
    "qa:report:validate-smtp": "node --env-file-if-exists=.env scripts/qa-report-send.js --validate-smtp",
    "smtp:smoke:verify": "node --env-file-if-exists=.env scripts/smtp-smoke-test.js --verify-only",
    "smtp:smoke:send": "node --env-file-if-exists=.env scripts/smtp-smoke-test.js --send-test",
    "qa:report:verify": "node scripts/verify-report-consistency.js --source sample",
    "qa:report:verify:zephyr": "node --env-file-if-exists=.env scripts/verify-report-consistency.js --source zephyr",
    "zephyr:config:check": "node --env-file-if-exists=.env scripts/zephyr-config-check.js",
    "qa:report:auth": "node --env-file-if-exists=.env scripts/qa-report-send.js --auth-only",
    "qa:report:send-validation": "node --env-file-if-exists=.env scripts/qa-report-send.js --send-validation --story SCRUM-5",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:record": "playwright codegen"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1"
  },
  "dependencies": {
    "@azure/msal-node": "^7.2.3",
    "@azure/msal-node-extensions": "^5.6.3",
    "exceljs": "^4.4.0",
    "nodemailer": "^7.0.13",
    "pdfkit": "^0.21.0"
  }
}
